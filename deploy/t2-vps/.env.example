# pilot = branch builds; latest = main
FRONTEND_TAG=pilot
# signed (default) | trusted-network (no signature check: only if nothing but the
# HRDD backend can reach the backend port)
BACKEND_SURFACE_AUTH=signed
# openssl rand -hex 32 — the backend's HRDD_FRONTEND_SECRET (installation secret),
# or this frontend's own secret from Admin → Frontends → Security
HRDD_BACKEND_SECRET=
HRDD_BACKEND_SECRET_PREVIOUS=
# Cloudflare Zero Trust → Networks → Tunnels → <tunnel> → token
TUNNEL_TOKEN=
