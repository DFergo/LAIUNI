# latest (follows main) or sha-<commit> to pin a version
BACKEND_TAG=latest
# Where the admin panel listens: 127.0.0.1, or this machine's LAN / Tailscale IP
ADMIN_BIND=127.0.0.1
BACKEND_ADMIN_PORT=8000
# openssl rand -hex 32 — give the same value to every frontend as HRDD_BACKEND_SECRET
HRDD_FRONTEND_SECRET=
